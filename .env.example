# strata Environment Variables Example
# Duplicate this file to .env or .env.local to customize your build settings

# AI Integration Configuration (Pre-configured for NVIDIA API Catalog)
VITE_AI_API_KEY=your_nvidia_api_key_here
VITE_AI_API_URL=https://integrate.api.nvidia.com/v1
VITE_AI_API_MODEL=meta/llama-3.1-70b-instruct

# Default Seed Passwords (Hashed)
VITE_DEV_PASSWORD_HASH=your_dev_password_hash_here
VITE_USER_PASSWORD_HASH=your_user_password_hash_here

# Rate Limiting & Security Configurations (Client-side simulation config)
VITE_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
VITE_AUTH_RATE_LIMIT_WINDOW_MS=60000
VITE_AI_RATE_LIMIT_MAX_ATTEMPTS=5
VITE_AI_RATE_LIMIT_WINDOW_MS=3600000
